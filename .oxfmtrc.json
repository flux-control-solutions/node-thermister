{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["CHANGELOG.md", "tools/oxlint/anti-slop/"],
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  }
}
